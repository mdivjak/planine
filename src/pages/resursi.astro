---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const page = await getEntry('pages', 'resursi');
if (!page) throw new Error('Nedostaje sadržaj stranice Resursi.');
const { Content } = await render(page);
---

<BaseLayout
  title={`${page.data.title} | Planine`}
  description={page.data.description}
>
  <PageHero
    eyebrow="Priprema je deo ture"
    title="Resursi"
    description="Alati i izvori koje proveravam pre nego što ranac stavim na leđa."
    image="/images/resources.svg"
  />
  <section class="section">
    <div class="container resources prose">
      <Content />
    </div>
  </section>
</BaseLayout>

<style>
  .resources {
    max-width: 850px;
  }

  :global(.resources h2) {
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  :global(.resources h2:first-child) {
    padding-top: 0;
    border-top: 0;
  }

  :global(.resources li) {
    padding-left: 0.35rem;
    margin-bottom: 0.8rem;
  }

  :global(.resources a) {
    font-weight: 700;
  }
</style>
