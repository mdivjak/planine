---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HikeDirectory from '../components/HikeDirectory.astro';
import TrailExplorerMap from '../components/TrailExplorerMap.astro';
import { connectHikes, formatDate, getHikes, hikePath, withBase } from '../utils/hikes';

const guides = await getCollection('guides');
const records = connectHikes(await getHikes(), guides).sort(
  (a, b) => b.hike.data.date.valueOf() - a.hike.data.date.valueOf(),
);
const latest = records.slice(0, 3);
---

<BaseLayout>
  <section class="hero" style={`--hero-image: url('${withBase('/images/hero-ridges.svg')}')`}>
    <div class="hero-art" aria-hidden="true"></div>
    <div class="container hero-content">
      <p class="hero-kicker">Planinarska zbirka · Beleške · GPX rute</p>
      <h1>Sve planine.<br /><em>Sve staze.</em></h1>
      <p class="hero-copy">
        Brzo pronađi turu, proveri praktične detalje i preuzmi GPX rutu za put.
      </p>
      <div class="hero-actions">
        <a class="button button--light" href="#imenik">Pretraži ture <span aria-hidden="true">↓</span></a>
        <a class="quiet-link" href={withBase('/o-sajtu/')}>O ovoj zbirci</a>
      </div>
    </div>
  </section>

  <section class="news-section">
    <div class="container news-card">
      <div>
        <span class="eyebrow">Najnovije dopune</span>
        <h2>Novosti</h2>
        <p>Tri poslednje ture dodate u arhivu.</p>
      </div>
      <div class="news-content">
        <ol>
          {latest.map((record) => (
            <li>
              <time datetime={record.hike.data.date.toISOString()}>{formatDate(record.hike.data.date)}</time>
              <a href={withBase(hikePath(record))}>{record.hike.data.title}</a>
              <span>{record.guide.data.country} · {record.guide.data.mountain}</span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section id="imenik" class="directory-section">
    <div class="container">
      <HikeDirectory records={records} />
      <TrailExplorerMap records={records} />
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    display: grid;
    min-height: 25rem;
    padding: 7.5rem 0 3.5rem;
    align-items: end;
    overflow: hidden;
    color: white;
    background:
      linear-gradient(90deg, rgba(11, 38, 31, 0.94) 0%, rgba(11, 38, 31, 0.58) 52%, rgba(11, 38, 31, 0.08) 100%),
      var(--hero-image) center / cover;
  }

  .hero::after {
    position: absolute;
    right: -10rem;
    bottom: -15rem;
    width: 38rem;
    height: 38rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    content: '';
  }

  .hero-content {
    position: relative;
    z-index: 2;
  }

  .hero-kicker {
    margin-bottom: 1.4rem;
    color: var(--lime);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 760px;
    margin-bottom: 1rem;
    font-size: clamp(3rem, 6vw, 5rem);
  }

  h1 em {
    color: var(--lime);
    font-weight: inherit;
  }

  .hero-copy {
    max-width: 560px;
    color: rgba(255, 255, 255, 0.75);
    font-size: clamp(1rem, 2vw, 1.2rem);
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .quiet-link {
    font-weight: 700;
    text-underline-offset: 5px;
  }

  .directory-section {
    position: relative;
    z-index: 3;
    padding: 0 0 clamp(4rem, 8vw, 7rem);
  }

  .news-section {
    position: relative;
    z-index: 3;
    padding: 0 0 1.5rem;
    margin-top: -2.5rem;
  }

  .news-card {
    display: grid;
    grid-template-columns: minmax(11rem, 0.28fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--paper);
    box-shadow: var(--shadow);
  }

  .news-card h2 {
    margin-bottom: 0.35rem;
    font-size: clamp(2rem, 4vw, 3rem);
  }

  .news-card > div:first-child > p {
    margin-bottom: 0;
    color: var(--ink-soft);
    font-size: 0.78rem;
  }

  .news-content ol {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .news-content li {
    display: grid;
    grid-template-columns: minmax(7.5rem, auto) minmax(0, 1fr) auto;
    gap: 1rem;
    padding: 0.75rem 0;
    border-top: 1px solid var(--line);
    align-items: baseline;
    font-size: 0.88rem;
  }

  .news-content li:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .news-content time,
  .news-content span {
    color: var(--ink-soft);
    font-size: 0.7rem;
  }

  .news-content a {
    font-weight: 700;
    text-decoration-color: var(--sun);
    text-underline-offset: 3px;
  }

  @media (max-width: 780px) {
    .hero {
      background-position: 64% center;
    }

    .news-section {
      padding-top: 1.25rem;
      margin-top: 0;
    }

    .news-card {
      grid-template-columns: 1fr;
    }

    .news-content li {
      grid-template-columns: 1fr;
      gap: 0.2rem;
      padding: 1rem 0;
    }

    .news-content li:first-child {
      padding-top: 0;
    }

    .news-content time {
      color: var(--fern);
      font-size: 0.62rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .news-content a {
      display: inline-flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 1rem;
      font-family: 'Newsreader', Georgia, serif;
      font-size: 1.2rem;
      line-height: 1.2;
      text-decoration: none;
    }

    .news-content a::after {
      flex: 0 0 auto;
      content: '→';
      font-family: 'DM Sans', system-ui, sans-serif;
      font-size: 0.9rem;
    }

    .news-content span {
      font-size: 0.66rem;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }
  }

  @media (max-width: 520px) {
    .hero-actions {
      align-items: flex-start;
      flex-direction: column;
    }

    .hero {
      min-height: 26rem;
    }
  }
</style>
