---
import { Image, getImage } from 'astro:assets';

interface Photo {
  src: ImageMetadata;
  alt: string;
  caption: string;
  emphasis?: 'wide';
}

interface Props {
  photos: Photo[];
  title: string;
}

const { photos, title } = Astro.props;
const preparedPhotos = await Promise.all(
  photos.map(async (photo) => {
    const largeWidth = Math.min(photo.src.width, 1920);
    const largeHeight = Math.round((photo.src.height / photo.src.width) * largeWidth);
    const large = await getImage({
      src: photo.src,
      width: largeWidth,
      format: 'webp',
      quality: 80,
    });
    const thumbnailWidths = [...new Set(
      [360, 640, 960, Math.min(photo.src.width, 960)].filter(
        (width) => width <= photo.src.width,
      ),
    )].sort((a, b) => a - b);

    return {
      ...photo,
      largeSrc: large.src,
      largeWidth,
      largeHeight,
      thumbnailWidths,
    };
  }),
);
---

<section
  class="photo-gallery"
  data-photo-gallery
  data-photos={JSON.stringify(
    preparedPhotos.map((photo) => ({
      src: photo.largeSrc,
      alt: photo.alt,
      caption: photo.caption,
      width: photo.largeWidth,
      height: photo.largeHeight,
    })),
  )}
  aria-label={`Fotografije sa ture ${title}`}
>
  <div class="photo-grid">
    {
      preparedPhotos.map((photo, index) => (
        <figure class:list={['photo-card', { 'is-wide': photo.emphasis === 'wide' }]}>
          <a
            class="photo-link"
            href={photo.largeSrc}
            data-photo-open={index}
            aria-label={`Uvećaj fotografiju ${index + 1}: ${photo.alt}`}
          >
            <Image
              class="photo-thumbnail"
              src={photo.src}
              alt={photo.alt}
              widths={photo.thumbnailWidths}
              sizes="(max-width: 520px) calc(100vw - 3rem), (max-width: 980px) 45vw, 360px"
              loading="lazy"
              decoding="async"
            />
            <span class="enlarge-hint" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <path d="M8 3H3v5M16 3h5v5M8 21H3v-5M16 21h5v-5"></path>
              </svg>
              Uvećaj
            </span>
          </a>
          <figcaption>{photo.caption}</figcaption>
        </figure>
      ))
    }
  </div>

  <dialog class="photo-dialog" data-photo-dialog aria-label={`Uvećane fotografije sa ture ${title}`}>
    <div class="dialog-frame">
      <button class="dialog-close" type="button" data-photo-close aria-label="Zatvori galeriju">
        <span aria-hidden="true">×</span>
      </button>
      <button class="dialog-nav is-previous" type="button" data-photo-previous aria-label="Prethodna fotografija">
        <span aria-hidden="true">←</span>
      </button>
      <figure class="dialog-figure" data-photo-stage>
        <img data-photo-large alt="" decoding="async" />
        <figcaption>
          <span data-photo-caption></span>
          <small data-photo-position aria-live="polite"></small>
        </figcaption>
      </figure>
      <button class="dialog-nav is-next" type="button" data-photo-next aria-label="Sledeća fotografija">
        <span aria-hidden="true">→</span>
      </button>
    </div>
  </dialog>
</section>

<script>
  import { initialisePhotoGalleries } from '../scripts/photo-gallery';

  initialisePhotoGalleries();
</script>

<style>
  .photo-gallery {
    margin: 2.5rem 0;
  }

  .photo-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .photo-card {
    min-width: 0;
    margin: 0;
  }

  .photo-card.is-wide {
    grid-column: 1 / -1;
  }

  .photo-link {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 0.75rem;
    color: white;
    background: var(--cream);
    box-shadow: 0 1px 0 rgba(24, 45, 37, 0.1);
  }

  .photo-link:focus-visible {
    outline: 4px solid var(--sun);
    outline-offset: 3px;
  }

  .photo-thumbnail {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 180ms ease;
  }

  .photo-link:hover .photo-thumbnail {
    transform: scale(1.015);
  }

  .enlarge-hint {
    position: absolute;
    right: 0.65rem;
    bottom: 0.65rem;
    display: inline-flex;
    padding: 0.42rem 0.6rem;
    border-radius: 999px;
    align-items: center;
    gap: 0.35rem;
    background: rgba(10, 33, 27, 0.86);
    box-shadow: 0 1px 8px rgba(0, 0, 0, 0.24);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .enlarge-hint svg {
    width: 0.9rem;
    height: 0.9rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }

  .photo-card > figcaption {
    padding: 0.7rem 0.1rem 0;
    color: var(--ink-soft);
    font-size: 0.78rem;
    line-height: 1.45;
  }

  .photo-dialog {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    padding: 0;
    border: 0;
    color: white;
    background: rgba(7, 19, 15, 0.97);
  }

  .photo-dialog::backdrop {
    background: rgba(7, 19, 15, 0.88);
  }

  .dialog-frame {
    position: relative;
    display: grid;
    width: 100%;
    height: 100%;
    padding:
      calc(1rem + env(safe-area-inset-top))
      calc(1rem + env(safe-area-inset-right))
      calc(1rem + env(safe-area-inset-bottom))
      calc(1rem + env(safe-area-inset-left));
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(0.5rem, 2vw, 1.5rem);
  }

  .dialog-figure {
    display: grid;
    min-width: 0;
    max-height: 100%;
    margin: 0;
    justify-items: center;
    gap: 0.8rem;
  }

  .dialog-figure img {
    display: block;
    max-width: 100%;
    max-height: calc(100dvh - 7.5rem);
    border-radius: 0.35rem;
    object-fit: contain;
  }

  .dialog-figure figcaption {
    display: grid;
    max-width: 70ch;
    justify-items: center;
    gap: 0.2rem;
    color: rgba(255, 255, 255, 0.88);
    text-align: center;
  }

  .dialog-figure small {
    color: rgba(255, 255, 255, 0.62);
    font-size: 0.72rem;
    font-weight: 700;
  }

  .dialog-close,
  .dialog-nav {
    display: grid;
    border: 1px solid rgba(255, 255, 255, 0.4);
    place-items: center;
    color: white;
    background: rgba(10, 33, 27, 0.76);
    cursor: pointer;
  }

  .dialog-close:hover,
  .dialog-nav:hover {
    background: var(--moss);
  }

  .dialog-close:focus-visible,
  .dialog-nav:focus-visible {
    outline: 4px solid var(--sun);
    outline-offset: 3px;
  }

  .dialog-close {
    position: absolute;
    z-index: 2;
    top: calc(1rem + env(safe-area-inset-top));
    right: calc(1rem + env(safe-area-inset-right));
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    font-size: 1.7rem;
    line-height: 1;
  }

  .dialog-nav {
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    font-size: 1.25rem;
  }

  .dialog-nav:disabled {
    visibility: hidden;
  }

  :global(html[data-photo-dialog-open]) {
    overflow: hidden;
  }

  @media (max-width: 520px) {
    .photo-grid {
      grid-template-columns: 1fr;
    }

    .photo-card.is-wide {
      grid-column: auto;
    }

    .dialog-frame {
      padding:
        calc(4rem + env(safe-area-inset-top))
        calc(0.65rem + env(safe-area-inset-right))
        calc(4.5rem + env(safe-area-inset-bottom))
        calc(0.65rem + env(safe-area-inset-left));
      grid-template-columns: 1fr 1fr;
      grid-template-rows: minmax(0, 1fr) auto;
    }

    .dialog-figure {
      grid-column: 1 / -1;
    }

    .dialog-figure img {
      max-height: calc(100dvh - 11rem);
    }

    .dialog-nav {
      width: 100%;
      height: 2.8rem;
      border-radius: 0.4rem;
    }

    .dialog-nav.is-previous {
      grid-column: 1;
    }

    .dialog-nav.is-next {
      grid-column: 2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .photo-thumbnail {
      transition: none;
    }
  }
</style>
