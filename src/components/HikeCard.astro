---
import type { HikeRecord } from '../utils/hikes';
import { formatDate, hikePath, withBase } from '../utils/hikes';

interface Props {
  record: HikeRecord;
}

const { record } = Astro.props;
const { hike, guide } = record;
const href = withBase(hikePath(record));
---

<article class="hike-card">
  <a class="image-link" href={href} aria-label={`Otvori turu ${hike.data.title}`}>
    <img src={withBase(guide.data.cover)} alt={guide.data.coverAlt} loading="lazy" />
  </a>
  <div class="card-body">
    <p class="meta">{guide.data.country} · {guide.data.mountain} · {hike.data.localArea}</p>
    <h3><a href={href}>{hike.data.title}</a></h3>
    <p>{hike.data.description}</p>
    <div class="card-footer">
      <time datetime={hike.data.date.toISOString()}>{formatDate(hike.data.date)}</time>
      {hike.data.distanceKm && <span>{hike.data.distanceKm} km</span>}
    </div>
  </div>
</article>

<style>
  .hike-card {
    display: grid;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--paper);
    box-shadow: 0 8px 25px rgba(35, 58, 49, 0.05);
  }

  .image-link {
    position: relative;
    display: block;
    min-height: 16rem;
    overflow: hidden;
  }

  img {
    width: 100%;
    height: 100%;
    min-height: 16rem;
    object-fit: cover;
    transition: transform 500ms ease;
  }

  .image-link:hover img {
    transform: scale(1.035);
  }

  .card-body {
    display: flex;
    padding: 1.4rem;
    flex-direction: column;
  }

  .meta {
    margin-bottom: 0.45rem;
    color: var(--fern);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  h3 {
    margin-bottom: 0.7rem;
  }

  h3 a {
    text-decoration: none;
  }

  .card-body > p:not(.meta) {
    color: var(--ink-soft);
    font-size: 0.92rem;
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1rem;
    margin-top: auto;
    border-top: 1px solid var(--line);
    color: var(--ink-soft);
    font-size: 0.76rem;
    font-weight: 600;
  }

</style>
