---
import { withBase } from '../utils/hikes';

const navigation = [
  { href: '/', label: 'Početna' },
  { href: '/#imenik', label: 'Ture' },
  { href: '/o-sajtu/', label: 'O sajtu' },
  { href: '/resursi/', label: 'Resursi' },
];
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href={withBase('/')} aria-label="Planine, početna">
      <svg viewBox="0 0 48 38" aria-hidden="true">
        <path d="m2 35 14-22 7 10L31 7l15 28H2Z" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"></path>
        <path d="m11 35 12-12 6 7 5-7 8 12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"></path>
      </svg>
      <span>Planine</span>
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="sr-only">Otvori meni</span>
      <span></span><span></span>
    </button>
    <nav id="site-nav" aria-label="Glavna navigacija">
      {
        navigation.map(({ href, label }) => (
          <a href={withBase(href)} aria-current={Astro.url.pathname === withBase(href) ? 'page' : undefined}>
            {label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.querySelector<HTMLElement>('#site-nav');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    nav?.classList.toggle('is-open', !open);
  });
</script>

<style>
  .site-header {
    position: absolute;
    z-index: 20;
    top: 0;
    left: 0;
    width: 100%;
    color: white;
  }

  .header-inner {
    display: flex;
    width: var(--content);
    min-height: 6.5rem;
    margin-inline: auto;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid rgba(255, 255, 255, 0.28);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-family: 'Newsreader', Georgia, serif;
    font-size: 1.5rem;
    font-weight: 600;
    text-decoration: none;
  }

  .brand svg {
    width: 2.2rem;
  }

  nav {
    display: flex;
    gap: 2rem;
  }

  nav a {
    position: relative;
    font-size: 0.94rem;
    font-weight: 600;
    text-decoration: none;
  }

  nav a::after {
    position: absolute;
    right: 0;
    bottom: -0.45rem;
    left: 0;
    height: 2px;
    content: '';
    background: var(--lime);
    transform: scaleX(0);
    transition: transform 160ms ease;
  }

  nav a:hover::after,
  nav a[aria-current='page']::after {
    transform: scaleX(1);
  }

  .menu-toggle {
    display: none;
    width: 2.8rem;
    height: 2.8rem;
    padding: 0.65rem;
    border: 1px solid rgba(255, 255, 255, 0.45);
    border-radius: 50%;
    color: inherit;
    background: transparent;
  }

  .menu-toggle span:not(.sr-only) {
    display: block;
    height: 2px;
    margin: 0.35rem 0;
    background: currentColor;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 720px) {
    .header-inner {
      min-height: 5.5rem;
    }

    .menu-toggle {
      display: block;
    }

    nav {
      position: absolute;
      top: 5.5rem;
      right: 1rem;
      left: 1rem;
      display: none;
      padding: 1rem;
      border-radius: 1rem;
      color: var(--ink);
      background: var(--paper);
      box-shadow: var(--shadow);
    }

    nav.is-open {
      display: grid;
    }

    nav a {
      padding: 0.65rem;
    }
  }
</style>
