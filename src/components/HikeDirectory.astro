---
import type { HikeRecord } from '../utils/hikes';
import { guidePath, withBase } from '../utils/hikes';

interface Props {
  records: HikeRecord[];
}

const { records } = Astro.props;
const countryOrder = ['srbija', 'crna-gora', 'slovenija', 'nepal'];
const grouped = Object.values(
  records.reduce<
    Record<
      string,
      {
        country: string;
        countrySlug: string;
        mountains: Record<string, { mountain: string; region: string; path: string; records: HikeRecord[] }>;
      }
    >
  >((countries, record) => {
    const key = record.guide.data.countrySlug;
    countries[key] ??= {
      country: record.guide.data.country,
      countrySlug: key,
      mountains: {},
    };
    countries[key].mountains[record.guide.id] ??= {
      mountain: record.guide.data.mountain,
      region: record.guide.data.region,
      path: guidePath(record.guide),
      records: [],
    };
    countries[key].mountains[record.guide.id].records.push(record);
    return countries;
  }, {}),
).sort((a, b) => {
  const aIndex = countryOrder.indexOf(a.countrySlug);
  const bIndex = countryOrder.indexOf(b.countrySlug);
  if (aIndex === -1 && bIndex === -1) return a.country.localeCompare(b.country, 'sr-Latn');
  if (aIndex === -1) return 1;
  if (bIndex === -1) return -1;
  return aIndex - bIndex;
});
const mountainCount = new Set(records.map((record) => record.guide.id)).size;
---

<section class="directory" data-directory>
  <div class="directory-intro">
    <div>
      <span class="eyebrow">Sve na jednom mestu</span>
      <h2 id="directory-title">Planine i staze</h2>
      <p>Izaberi zemlju, zatim planinu. Svaki link vodi na sve dostupne ture za tu planinu.</p>
    </div>
    <div class="directory-stats" aria-label="Sadržaj arhive">
      <span><strong>{records.length}</strong> ture</span>
      <span><strong>{mountainCount}</strong> planine</span>
      <span><strong>{grouped.length}</strong> zemlje</span>
    </div>
  </div>

  <div class="search-panel" role="search">
    <label for="hike-search">Pretraži planine i ture</label>
    <div class="search-control">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="11" cy="11" r="6.5"></circle>
        <path d="m16 16 4 4"></path>
      </svg>
      <input
        id="hike-search"
        type="search"
        placeholder="Na primer: Durmitor, Vojvodina, Nepal…"
        autocomplete="off"
        aria-controls="hike-directory"
        aria-describedby="search-help search-status"
      />
      <button type="button" data-search-clear hidden>Obriši</button>
    </div>
    <div class="search-meta">
      <p id="search-help">Pretraga obuhvata naziv ture, planinu, region i zemlju.</p>
      <p id="search-status" aria-live="polite"><strong data-result-count>{mountainCount}</strong> dostupne planine</p>
    </div>
    <noscript><p class="no-script">Pretraga zahteva JavaScript, ali je kompletan imenik dostupan ispod.</p></noscript>
  </div>

  <div id="hike-directory" class="country-list" aria-labelledby="directory-title">
    {
      grouped.map((country) => {
        const countryCount = Object.values(country.mountains).flatMap((mountain) => mountain.records).length;
        const mountains = Object.values(country.mountains).sort((a, b) =>
          a.mountain.localeCompare(b.mountain, 'sr-Latn'),
        );

        return (
          <section class="country-group" data-country-group>
            <header class="country-heading">
              <h3>{country.country}</h3>
              <p>{mountains.length} {mountains.length === 1 ? 'planina' : 'planine'} · {countryCount} {countryCount === 1 ? 'tura' : 'ture'}</p>
              <a href={withBase(`/destinacije/${country.countrySlug}/`)} aria-label={`Otvori sve ture za ${country.country}`}>
                Sve ture <span aria-hidden="true">↗</span>
              </a>
            </header>

            <ol class="mountain-list">
              {mountains.map((mountain) => (
                <li
                  data-mountain-item
                  data-search={[
                    mountain.mountain,
                    mountain.region,
                    country.country,
                    ...mountain.records.flatMap((record) => [
                      record.hike.data.title,
                      record.hike.data.localArea,
                      ...record.hike.data.tags,
                    ]),
                  ].join(' ')}
                >
                  <a href={withBase(mountain.path)}>
                    <span>
                      <strong>{mountain.mountain}</strong>
                      <small>{mountain.region}</small>
                    </span>
                    <em>{mountain.records.length} {mountain.records.length === 1 ? 'tura' : 'ture'}</em>
                    <span class="arrow" aria-hidden="true">→</span>
                  </a>
                </li>
              ))}
            </ol>
          </section>
        );
      })
    }
  </div>

  <p class="empty-state" data-empty-state hidden>
    Nema planina ili tura koje odgovaraju pretrazi. Probaj naziv planine, regiona ili zemlje.
  </p>
</section>

<script>
  const normalise = (value: string) =>
    value
      .normalize('NFD')
      .replace(/\p{Diacritic}/gu, '')
      .toLocaleLowerCase('sr-Latn')
      .trim();

  const initialiseDirectory = () => {
    document.querySelectorAll<HTMLElement>('[data-directory]:not([data-ready])').forEach((directory) => {
      directory.dataset.ready = 'true';
      const input = directory.querySelector<HTMLInputElement>('#hike-search');
      const clear = directory.querySelector<HTMLButtonElement>('[data-search-clear]');
      const resultCount = directory.querySelector<HTMLElement>('[data-result-count]');
      const status = directory.querySelector<HTMLElement>('#search-status');
      const emptyState = directory.querySelector<HTMLElement>('[data-empty-state]');
      const items = [...directory.querySelectorAll<HTMLElement>('[data-mountain-item]')];
      const countries = [...directory.querySelectorAll<HTMLElement>('[data-country-group]')];

      if (!input || !clear || !resultCount || !status || !emptyState) return;

      const filter = () => {
        const query = normalise(input.value);
        let visibleCount = 0;

        items.forEach((item) => {
          const matches = !query || normalise(item.dataset.search ?? '').includes(query);
          item.hidden = !matches;
          if (matches) visibleCount += 1;
        });

        countries.forEach((country) => {
          country.hidden = !country.querySelector('[data-mountain-item]:not([hidden])');
        });

        clear.hidden = !query;
        emptyState.hidden = visibleCount !== 0;
        resultCount.textContent = String(visibleCount);
        status.lastChild!.textContent =
          visibleCount === 1
            ? ' pronađena planina'
            : visibleCount >= 2 && visibleCount <= 4
              ? ' pronađene planine'
              : ' pronađenih planina';
      };

      input.addEventListener('input', filter);
      input.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && input.value) {
          input.value = '';
          filter();
        }
      });
      clear.addEventListener('click', () => {
        input.value = '';
        filter();
        input.focus();
      });
    });
  };

  initialiseDirectory();
  document.addEventListener('astro:page-load', initialiseDirectory);
</script>

<style>
  .directory {
    padding: clamp(2rem, 4vw, 3rem);
    border-radius: 2rem;
    background: var(--paper);
    box-shadow: var(--shadow);
  }

  .directory-intro {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .directory-intro h2 {
    margin-bottom: 0.5rem;
  }

  .directory-intro p {
    max-width: 620px;
    margin-bottom: 0;
    color: var(--ink-soft);
  }

  .directory-stats {
    display: flex;
    flex: 0 0 auto;
    gap: 1.5rem;
    color: var(--ink-soft);
    font-size: 0.72rem;
    text-transform: uppercase;
  }

  .directory-stats strong {
    display: block;
    color: var(--ink);
    font-family: 'Newsreader', Georgia, serif;
    font-size: 1.8rem;
    line-height: 1;
  }

  .search-panel {
    padding: 1.25rem;
    margin-bottom: 2rem;
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: var(--cream);
  }

  .search-panel > label {
    display: block;
    margin-bottom: 0.55rem;
    font-size: 0.82rem;
    font-weight: 700;
  }

  .search-control {
    display: flex;
    min-height: 3.6rem;
    padding: 0 0.8rem;
    border: 1px solid rgba(23, 53, 44, 0.28);
    border-radius: 0.8rem;
    align-items: center;
    background: white;
  }

  .search-control:focus-within {
    border-color: var(--moss);
    outline: 3px solid rgba(97, 128, 109, 0.18);
  }

  .search-control svg {
    width: 1.25rem;
    margin-right: 0.7rem;
    fill: none;
    stroke: var(--fern);
    stroke-linecap: round;
    stroke-width: 1.8;
  }

  input {
    width: 100%;
    min-width: 0;
    border: 0;
    outline: 0;
    color: var(--ink);
    background: transparent;
    font: inherit;
  }

  input::placeholder {
    color: #84938d;
  }

  .search-control button {
    padding: 0.35rem 0.6rem;
    border: 0;
    color: var(--moss);
    background: transparent;
    font: inherit;
    font-size: 0.76rem;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  .search-meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.65rem;
    color: var(--ink-soft);
    font-size: 0.72rem;
  }

  .search-meta p {
    margin-bottom: 0;
  }

  #search-status {
    flex: 0 0 auto;
  }

  .no-script {
    margin: 0.7rem 0 0;
    color: var(--ink-soft);
    font-size: 0.75rem;
  }

  .country-group + .country-group {
    margin-top: 2.5rem;
  }

  .country-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    gap: 1rem;
    padding-bottom: 0.55rem;
    border-bottom: 2px solid var(--ink);
    align-items: baseline;
  }

  .country-heading h3 {
    margin: 0;
    font-size: clamp(1.75rem, 3vw, 2.4rem);
  }

  .country-heading a {
    font-size: 0.7rem;
    font-weight: 700;
    text-decoration: none;
    text-underline-offset: 4px;
    white-space: nowrap;
  }

  .country-heading a:hover,
  .country-heading a:focus-visible {
    text-decoration: underline;
  }

  .country-heading a span {
    margin-left: 0.2rem;
  }

  .country-heading p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.7rem;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .mountain-list {
    padding: 0.5rem 0 0 1.8rem;
    margin: 0;
    column-count: 3;
    column-gap: 2.5rem;
  }

  .mountain-list li {
    padding-left: 0.1rem;
    border-bottom: 1px solid var(--line);
    break-inside: avoid;
  }

  .mountain-list li::marker {
    color: var(--fern);
    font-family: 'Newsreader', Georgia, serif;
    font-size: 0.82rem;
    font-variant-numeric: tabular-nums;
  }

  .mountain-list li a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto 0.8rem;
    gap: 0.55rem;
    padding: 0.5rem 0.1rem;
    align-items: center;
    text-decoration: none;
    transition:
      transform 160ms ease,
      color 160ms ease;
  }

  .mountain-list li a:hover,
  .mountain-list li a:focus-visible {
    color: var(--moss);
    transform: translateX(0.18rem);
  }

  .mountain-list li a > span:first-child {
    display: grid;
    min-width: 0;
  }

  .mountain-list strong {
    font-family: 'Newsreader', Georgia, serif;
    font-size: 1rem;
    line-height: 1.15;
  }

  .mountain-list small {
    overflow: hidden;
    color: var(--ink-soft);
    font-size: 0.66rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .mountain-list em {
    color: var(--ink-soft);
    font-size: 0.64rem;
    font-style: normal;
    white-space: nowrap;
  }

  .arrow {
    font-size: 0.9rem;
  }

  .empty-state {
    padding: 2rem;
    border: 1px dashed var(--line);
    border-radius: 1rem;
    color: var(--ink-soft);
    text-align: center;
  }

  [hidden] {
    display: none !important;
  }

  @media (max-width: 760px) {
    .directory {
      padding: 2rem 1.2rem;
      border-radius: 1.2rem;
    }

    .directory-intro {
      display: block;
    }

    .directory-stats {
      margin-top: 1.5rem;
    }

    .search-meta {
      display: block;
    }

    #search-status {
      margin-top: 0.35rem;
    }

    .mountain-list {
      column-count: 2;
    }
  }

  @media (max-width: 480px) {
    .country-heading {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }

    .country-heading a,
    .country-heading p {
      text-align: left;
    }

    .country-heading p {
      margin-top: 0.15rem;
    }

    .mountain-list {
      padding-left: 1.6rem;
      column-count: 1;
    }

    .mountain-list small {
      white-space: normal;
    }
  }
</style>
